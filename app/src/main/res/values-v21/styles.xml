<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- To encapsulate elevation & status bar color -->
    <style name="Theme.Keepass.Light.v21" parent="Theme.Keepass.Light.Base">
        <item name="preferenceTheme">@style/KeepassDXStyle.Preference.Theme</item>
        <item name="android:statusBarColor">@color/grey_dark</item>
        <item name="android:navigationBarColor">@color/grey_dark</item>
    </style>

    <style name="Theme.Keepass.Dark.v21" parent="Theme.Keepass.Dark.Base">
        <item name="preferenceTheme">@style/KeepassDXStyle.Preference.Theme</item>
        <item name="android:statusBarColor">@color/grey_dark</item>
        <item name="android:navigationBarColor">@color/grey_dark</item>
    </style>

    <!-- Toolbar -->
    <style name="Theme.Keepass.Toolbar.v21" parent="Theme.Keepass.Toolbar.Base">
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Action Style -->
    <style name="Theme.Keepass.Toolbar.Action" parent="Theme.Keepass.Toolbar">
        <item name="android:backgroundTint">@color/surface_selector</item>
    </style>

    <!-- Preference Theme -->
    <style name="KeepassDXStyle.Preference.Theme" parent="@style/PreferenceThemeOverlay">
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <!-- Button Style -->
    <style name="Theme.Keepass.v21.ImageButton" parent="Theme.Keepass.Base.ImageButton">
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Menu FAB -->
</resources>

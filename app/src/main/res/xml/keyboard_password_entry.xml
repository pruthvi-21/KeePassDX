<Keyboard xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:horizontalGap="1%p"
    app:keyHeight="38dp"
    app:verticalGap="8dp"
    tools:targetApi="o">
    <Row>
        <Key
            app:codes="520"
            app:horizontalGap="1%p"
            app:isRepeatable="false"
            app:keyEdgeFlags="left"
            app:keyIcon="@drawable/ic_keyboard_link_24dp"
            app:keyWidth="15%p"
            app:tooltipText="@string/entry_url" />
        <Key
            app:codes="500"
            app:horizontalGap="2%p"
            app:isRepeatable="false"
            app:keyIcon="@drawable/ic_keyboard_person_24dp"
            app:keyWidth="17%p"
            app:tooltipText="@string/entry_user_name" />
        <Key
            app:codes="510"
            app:horizontalGap="1%p"
            app:isRepeatable="false"
            app:keyIcon="@drawable/ic_keyboard_password_24dp"
            app:keyWidth="28%p"
            app:tooltipText="@string/entry_password" />
        <Key
            app:codes="515"
            app:horizontalGap="2%p"
            app:isRepeatable="false"
            app:keyIcon="@drawable/ic_keyboard_otp_24dp"
            app:keyWidth="17%p"
            app:tooltipText="@string/entry_otp" />
        <Key
            app:codes="530"
            app:horizontalGap="1%p"
            app:isRepeatable="false"
            app:keyEdgeFlags="right"
            app:keyIcon="@drawable/ic_keyboard_list_24dp"
            app:keyWidth="15%p"
            app:tooltipText="@string/custom_fields" />
    </Row>
    <Row app:rowEdgeFlags="bottom">
        <Key
            app:codes="600"
            app:horizontalGap="1%p"
            app:isRepeatable="false"
            app:keyEdgeFlags="left"
            app:keyIcon="@drawable/ic_keyboard_keyboard_24dp"
            app:keyWidth="17%p"
            app:tooltipText="@string/back_to_previous_keyboard" />
        <Key
            app:codes="611"
            app:horizontalGap="2%p"
            app:isRepeatable="false"
            app:keyIcon="@drawable/ic_keyboard_lock_24dp"
            app:keyWidth="26%p"
            app:tooltipText="@string/lock" />
        <Key
            app:codes="620"
            app:horizontalGap="1%p"
            app:isRepeatable="false"
            app:keyIcon="@drawable/ic_keyboard_key_24dp"
            app:keyWidth="18%p"
            app:tooltipText="@string/select_entry" />
        <Key
            app:codes="-5"
            app:horizontalGap="2%p"
            app:isRepeatable="true"
            app:keyIcon="@drawable/ic_keyboard_backspace_24dp"
            app:keyWidth="14%p"
            app:tooltipText="@string/backspace" />
        <Key
            app:codes="-4"
            app:horizontalGap="1%p"
            app:isRepeatable="false"
            app:keyEdgeFlags="right"
            app:keyIcon="@drawable/ic_keyboard_return_24dp"
            app:keyWidth="17%p"
            app:tooltipText="@string/enter" />
    </Row>
</Keyboard>
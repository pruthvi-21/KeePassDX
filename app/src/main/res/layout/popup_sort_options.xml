<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="?popupBackgroundColor"
        app:cardCornerRadius="@dimen/small_card_radius"
        app:cardElevation="8dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioGroup
                    android:id="@+id/sort_options_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/sort_option_db"
                        style="@style/Theme.Keepass.PopupWindow.Sort.Item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_db" />

                    <RadioButton
                        android:id="@+id/sort_option_title"
                        style="@style/Theme.Keepass.PopupWindow.Sort.Item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_title" />

                    <RadioButton
                        android:id="@+id/sort_option_username"
                        style="@style/Theme.Keepass.PopupWindow.Sort.Item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_username" />

                    <RadioButton
                        android:id="@+id/sort_option_creation_time"
                        style="@style/Theme.Keepass.PopupWindow.Sort.Item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_creation_time" />

                    <RadioButton
                        android:id="@+id/sort_option_last_modify_time"
                        style="@style/Theme.Keepass.PopupWindow.Sort.Item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_last_modify_time" />

                    <RadioButton
                        android:id="@+id/sort_option_last_access_time"
                        style="@style/Theme.Keepass.PopupWindow.Sort.Item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sort_last_access_time" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/additional_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?popupBackgroundColor"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:background="@color/popup_divider_color"
                        android:paddingTop="1dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/background_bottom_sheet"
    android:orientation="vertical"
    android:paddingVertical="@dimen/default_margin">

    <androidx.cardview.widget.CardView
        android:layout_width="35dp"
        android:layout_height="5dp"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.5"
        app:cardBackgroundColor="?android:textColorSecondary"
        app:cardCornerRadius="20dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/sort_selection_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/default_margin"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/sort_selection_db"
            style="@style/Theme.Keepass.Chip.Filter.Sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_db"
            app:chipIcon="@drawable/ic_check_white_24dp"
            app:chipIconTint="?colorSecondary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sort_selection_title"
            style="@style/Theme.Keepass.Chip.Filter.Sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_title" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sort_selection_username"
            style="@style/Theme.Keepass.Chip.Filter.Sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_username" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sort_selection_creation_time"
            style="@style/Theme.Keepass.Chip.Filter.Sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_creation_time" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sort_selection_last_modify_time"
            style="@style/Theme.Keepass.Chip.Filter.Sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_last_modify_time" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sort_selection_last_access_time"
            style="@style/Theme.Keepass.Chip.Filter.Sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_last_access_time" />
    </com.google.android.material.chip.ChipGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="15dp"
        android:alpha="0.15"
        android:background="?android:textColorSecondary" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/sort_order_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/default_margin"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/sort_order_asc"
            style="@style/Theme.Keepass.Chip.Filter.Sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_ascending"
            app:closeIcon="@drawable/ic_sort_order_ascending"
            app:closeIconVisible="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sort_order_dsc"
            style="@style/Theme.Keepass.Chip.Filter.Sort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_descending"
            app:closeIcon="@drawable/ic_sort_order_descending"
            app:closeIconVisible="true" />
    </com.google.android.material.chip.ChipGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="15dp"
        android:alpha="0.15"
        android:background="?android:textColorSecondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/default_margin">

        <CheckBox
            android:id="@+id/sort_selection_groups_before"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_groups_before" />

        <CheckBox
            android:id="@+id/sort_selection_recycle_bin_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_recycle_bin_bottom" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ok"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@android:string/ok"
            app:cornerRadius="@dimen/card_radius" />
    </LinearLayout>
</LinearLayout>

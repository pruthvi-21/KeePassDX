<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:filterTouchesWhenObscured="true"
    android:orientation="vertical">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/expiration_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_an_expiry_date" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/expiration_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/entry_expires"
        app:endIconDrawable="@drawable/ic_day_white_24dp"
        app:endIconMode="custom"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/expiration_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:cursorVisible="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            tools:text="2020-03-04 05:00" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
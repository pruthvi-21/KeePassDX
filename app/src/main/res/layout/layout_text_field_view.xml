<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label_view"
                style="@style/Theme.Keepass.TextAppearance.LabelTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Label" />

            <TextView
                android:id="@+id/value_view"
                style="@style/Theme.Keepass.TextAppearance.TextNode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textIsSelectable="true"
                tools:text="Ram.21313" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/show_btn"
                style="@style/Theme.Keepass.ImageButton.Simple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/menu_showpass"
                android:src="@drawable/ic_visibility_state"
                app:tint="?android:textColorSecondary" />

            <ImageButton
                android:id="@+id/copy_btn"
                style="@style/Theme.Keepass.ImageButton.Simple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/menu_copy"
                android:src="@drawable/ic_content_copy_white_24dp"
                app:tint="?android:textColorSecondary" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/entry_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="6dp"
        android:indeterminate="false"
        android:max="30"
        android:progress="10"
        android:visibility="gone"
        app:indicatorColor="?colorSecondary"
        app:trackColor="?colorSurfaceVariant2"
        app:trackCornerRadius="10dp"
        app:trackThickness="7dp"
        tools:visibility="visible" />

    <include layout="@layout/divider" />

</LinearLayout>
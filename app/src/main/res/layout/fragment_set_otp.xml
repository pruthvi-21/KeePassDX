<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAutofill="noExcludeDescendants"
        android:orientation="vertical"
        android:padding="@dimen/default_margin"
        tools:targetApi="o">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Theme.Keepass.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/entry_add_otp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/otp_information"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/otp_information"
                style="@style/Theme.Keepass.ImageButton.Simple"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/content_description_otp_information"
                android:src="@drawable/ic_info_white_24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/setup_otp_type_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_view_margin_horizontal"
            android:layout_marginLeft="@dimen/card_view_margin_horizontal"
            android:layout_marginEnd="@dimen/card_view_margin_horizontal"
            android:layout_marginRight="@dimen/card_view_margin_horizontal"
            android:text="@string/error_otp_type"
            android:textColor="?attr/colorSecondary" />

        <LinearLayout
            android:id="@+id/card_view_otp_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="@dimen/default_margin"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/otp_type_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:checkedButton="@id/otp_type_totp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/otp_type_totp"
                    style="?materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/otp_type_totp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/otp_type_hotp"
                    style="?materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/otp_type_hotp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/setup_otp_token_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:background="@drawable/background_spinner"
                android:minHeight="48dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/setup_otp_secret_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconMode="password_toggle"
                app:endIconTint="?attr/colorSecondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/setup_otp_secret"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/otp_secret"
                    android:importantForAccessibility="no"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_view_otp_advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    style="@style/Theme.KeePass.TextInput.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="5dp"
                    android:text="@string/otp_algorithm" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/otp_algo_group"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    app:checkedButton="@id/algo_sha1"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/algo_sha1"
                        style="?materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/otp_algorithm_sha1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/algo_sha256"
                        style="?materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/otp_algorithm_sha256" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/algo_sha512"
                        style="?materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/otp_algorithm_sha512" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/label_period"
                    style="@style/Theme.KeePass.TextInput.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="5dp"
                    android:text="@string/otp_period" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/setup_otp_period_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:visibility="visible">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/setup_otp_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789"
                        android:hint="@string/otp_period"
                        android:imeOptions="actionNext"
                        android:importantForAccessibility="no"
                        android:importantForAutofill="no"
                        android:inputType="numberSigned"
                        android:maxLength="3"
                        tools:text="30" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/label_counter"
                    style="@style/Theme.KeePass.TextInput.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/otp_counter" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/setup_otp_counter_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="3dp"
                    android:visibility="visible">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/setup_otp_counter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/otp_counter"
                        android:imeOptions="actionNext"
                        android:importantForAccessibility="no"
                        android:importantForAutofill="no"
                        android:inputType="numberSigned"
                        tools:text="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/label_digits"
                    style="@style/Theme.KeePass.TextInput.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/otp_digits" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/setup_otp_digits_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/setup_otp_digits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:digits="0123456789"
                        android:hint="@string/otp_digits"
                        android:imeOptions="actionNext"
                        android:importantForAccessibility="no"
                        android:importantForAutofill="no"
                        android:inputType="numberSigned"
                        android:maxLength="2"
                        tools:text="6" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
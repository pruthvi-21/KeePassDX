<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/entry_section_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/card_view_margin_vertical"
    android:paddingBottom="24dp">

    <LinearLayout
        android:id="@+id/metadata_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.kunzisoft.keepass.view.TextFieldView
            android:id="@+id/uuid_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.kunzisoft.keepass.view.TextFieldView
            android:id="@+id/created_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.kunzisoft.keepass.view.TextFieldView
            android:id="@+id/modified_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/history_count_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/default_margin"
            android:paddingEnd="@dimen/default_margin">

            <TextView
                style="@style/Theme.Keepass.TextAppearance.LabelTextStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History: " />

            <TextView
                android:id="@+id/history_count_view"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:gravity="start|center_vertical"
                android:minWidth="20dp"
                android:padding="0dp"
                tools:text="5" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/default_margin"
            android:layout_marginEnd="@dimen/default_margin"
            android:background="?colorDivider" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/attachments_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/entry_attachments_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="true" />

        <TextView
            android:id="@+id/no_attachments_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minHeight="200dp"
            android:text="@string/entry_no_attachments"
            android:textColor="?android:textColorSecondary"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/content_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/entry_tags_list_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <com.kunzisoft.keepass.view.TemplateView
                android:id="@+id/entry_template"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/no_details_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minHeight="200dp"
            android:text="@string/no_details_text"
            android:textColor="?android:textColorSecondary"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
